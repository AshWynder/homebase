// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUMS
enum Role {
  OWNER
  CARETAKER
  TENANT
}

enum MeterType {
  WATER
  ELECTRICITY
}

enum InvoiceLineItemType {
  RENT
  WATER
  GARBAGE
  SERVICE_CHARGE
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentMethod {
  MPESA_STK
  MPESA_C2B
  CARD
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
}

enum PaymentProvider {
  DARAJA
  PAYSTACK
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// better-auth models

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]

  profile UserProfile?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

model Jwks {
  id         String    @id
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime? @map("expires_at")
  alg        String?
  crv        String?

  @@map("jwks")
}

// user identity models
model UserProfile {
  id String @id @default(uuid(7))

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone      String  @unique
  role       Role    @default(TENANT)
  nationalId String? @unique @map("national_id")

  ownedProperties   Property[]        @relation("OwnerProperties")
  managedProperties Property[]        @relation("CaretakerProperties")
  tenancies         Tenancy[]
  notices           NoticeRecipient[]
  sentMessages      ChatMessage[]     @relation("SentMessages")
  receivedMessages  ChatMessage[]     @relation("ReceivedMessages")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_profile")
}

// property
model Property {
  id      String  @id @default(uuid(7))
  name    String
  address String?

  ownerId String      @map("owner_id")
  owner   UserProfile @relation("OwnerProperties", fields: [ownerId], references: [id])

  caretakerId String?      @map("caretaker_id")
  caretaker   UserProfile? @relation("CaretakerProperties", fields: [caretakerId], references: [id])

  units Unit[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("property")
}

model Unit {
  id         String  @id @default(uuid(7))
  unitNumber String  @map("unit_number")
  blockName  String? @map("block_name")

  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  tenancies          Tenancy[]
  utilityMeters      UtilityMeter[]
  invoices           Invoice[]
  maintenanceTickets MaintenanceTicket[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("unit")
}

model Tenancy {
  id String @id @default(uuid(7))

  tenantId String      @map("tenant_id")
  tenant   UserProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  unitId String @map("unit_id")
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  rentAmount Decimal   @map("rent_amount") @db.Decimal(12, 2)
  startDate  DateTime  @map("start_date")
  endDate    DateTime? @map("end_date")
  isActive   Boolean   @default(true) @map("is_active")
  terminationReason      String?   @map("termination_reason")
  terminationNotes       String?   @map("termination_notes")
  terminationRequestedAt DateTime? @map("termination_requested_at")

  invoices Invoice[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenancy")
}

// billing & finance
model UtilityMeter {
  id String @id @default(uuid(7))

  unitId String @map("unit_id")
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  meterType   MeterType @default(WATER) @map("meter_type")
  meterNumber String?   @unique @map("meter_number")
  lastReading Int       @default(0) @map("last_reading")
  pricePerUnit Decimal  @default(150.00) @map("price_per_unit") @db.Decimal(10, 2)

  readings MeterReading[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([unitId, meterType])
  @@map("utility_meter")
}

model MeterReading {
  id String @id @default(uuid(7))

  meterId String       @map("meter_id")
  meter   UtilityMeter @relation(fields: [meterId], references: [id], onDelete: Cascade)

  currentReading Int      @map("current_reading")
  unitsConsumed  Int      @map("units_consumed")
  pricePerUnit   Decimal  @map("price_per_unit") @db.Decimal(10, 2)
  consumptionCost Decimal @map("consumption_cost") @db.Decimal(12, 2)
  readingDate    DateTime @default(now()) @map("reading_date")

  lineItem InvoiceLineItem?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("meter_reading")
}

model Invoice {
  id String @id @default(uuid(7))

  unitId String @map("unit_id")
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  tenancyId String  @map("tenancy_id")
  tenancy   Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  periodStart DateTime    @map("period_start")
  periodEnd   DateTime    @map("period_end")
  amount      Decimal     @db.Decimal(12, 2)
  balanceDue  Decimal     @map("balance_due") @db.Decimal(12, 2)
  dueDate     DateTime    @map("due_date")
  status      InvoiceStatus @default(UNPAID)

  lineItems InvoiceLineItem[]
  payments  Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenancyId, periodStart])
  @@index([unitId])
  @@index([status])
  @@map("invoice")
}

model InvoiceLineItem {
  id String @id @default(uuid(7))

  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  type InvoiceLineItemType @default(RENT)
  description String
  amount      Decimal @db.Decimal(12, 2)

  meterReadingId String?       @unique @map("meter_reading_id")
  meterReading   MeterReading? @relation(fields: [meterReadingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("invoice_line_item")
}

model Payment {
  id String @id @default(uuid(7))

  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount         Decimal         @db.Decimal(12, 2)
  method         PaymentMethod
  provider       PaymentProvider
  transactionRef String          @unique @map("transaction_ref")
  phoneNumber    String?         @map("phone_number")
  status         PaymentStatus   @default(PENDING)

  // Daraja (M-Pesa)
  checkoutRequestId String? @unique @map("checkout_request_id")
  merchantRequestId String? @map("merchant_request_id")
  mpesaReceiptNumber String? @map("mpesa_receipt_number")

  // Paystack (Card)
  authorizationUrl String? @map("authorization_url")

  failureReason String?    @map("failure_reason")
  paidAt        DateTime?  @map("paid_at")
  rawPayload    Json?      @map("raw_payload")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([invoiceId])
  @@index([status])
  @@map("payment")
}

// operational models
model MaintenanceTicket {
  id String @id @default(uuid(7))

  unitId String @map("unit_id")
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  description String
  photoUrl    String?      @map("photo_url")
  status      TicketStatus @default(OPEN)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("maintenance_ticket")
}

model Notice {
  id      String @id @default(uuid(7))
  title   String
  message String

  recipients NoticeRecipient[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("notice")
}

model NoticeRecipient {
  id String @id @default(uuid(7))

  noticeId String @map("notice_id")
  notice   Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  tenantId String      @map("tenant_id")
  tenant   UserProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  isRead Boolean @default(false) @map("is_read")

  @@map("notice_recipient")
}

model ChatMessage {
  id String @id @default(uuid(7))

  senderId String      @map("sender_id")
  sender   UserProfile @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId String?      @map("receiver_id")
  receiver   UserProfile? @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: SetNull)
  content    String

  createdAt DateTime @default(now()) @map("created_at")

  @@map("chat_message")
}
