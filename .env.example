# Copy to .env and fill in. Never commit .env.

# Postgres: reuses the amazon1 Postgres container on amazon1_default.
# Create the database/role once (see deployment notes):
#   CREATE ROLE homebase LOGIN PASSWORD '<password>';
#   CREATE DATABASE homebase OWNER homebase;
DATABASE_URL=postgresql://homebase:CHANGE_ME@postgres:5432/homebase

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=https://homebase-api.tronzilla.duckdns.org
BETTER_AUTH_TRUSTED_ORIGINS=https://homebase-api.tronzilla.duckdns.org

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=https://homebase-api.tronzilla.duckdns.org

# Cloudflare R2 (maintenance photo uploads)
ACCOUNT_ID=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
BUCKET_NAME=
PUBLIC_URL=

# M-Pesa Daraja
DARAJA_ENV=production
MPESA_BASE_URL=https://api.safaricom.co.ke
MPESA_STK_SHORTCODE=
MPESA_STK_PASSKEY=
MPESA_STK_CALLBACK_URL=https://homebase-api.tronzilla.duckdns.org/payments/stk-callback
MPESA_C2B_SHORTCODE=
MPESA_C2B_RESPONSE_TYPE=Completed
MPESA_C2B_VALIDATION_URL=https://homebase-api.tronzilla.duckdns.org/payments/c2b-validation
MPESA_C2B_CONFIRMATION_URL=https://homebase-api.tronzilla.duckdns.org/payments/c2b-confirmation
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_BASE_URL=https://homebase-api.tronzilla.duckdns.org
