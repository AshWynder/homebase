# Copy this to `.env` and set the URL of your backend.
# EXPO_PUBLIC_* vars are inlined at bundle time — restart Metro (npx expo start -c)
# after changing them.
#
# Leave EXPO_PUBLIC_API_URL unset to auto-detect the Metro host (works on LAN
# devices and emulators without any configuration).
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000